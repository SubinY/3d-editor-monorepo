{
  "name": "@mh/3d-editor",
  "version": "0.1.2",
  "description": "Unified 2D/3D editor SDK: document core, catalog interface, dual viewports (single required install)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "http://192.168.100.213:8081/repository/npm-private/"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc -b --force",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "three": "^0.160.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "three": ">=0.158.0"
  }
}
