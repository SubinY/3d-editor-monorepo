{
  "name": "@3d-editor/presets",
  "version": "0.1.0",
  "description": "Scene and editor presets for 3d-editor (factory, campus, datacenter, etc.)",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc -b --force",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@3d-editor/extensions": "workspace:*"
  },
  "devDependencies": {
    "@3d-editor/editor": "workspace:*",
    "@types/three": "^0.160.0",
    "three": "^0.160.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "@3d-editor/editor": "^0.1.0",
    "three": ">=0.158.0"
  }
}
