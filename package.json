{
  "name": "3d-editor-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for @3d-editor/editor SDK and host playgrounds",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev --filter=@3d-editor/editor --filter=electrical-room --filter=electrical-room-api",
    "dev:editor": "turbo run dev --filter=@3d-editor/editor",
    "dev:host": "turbo run dev --filter=electrical-room --filter=electrical-room-api",
    "build": "turbo run build --filter=@3d-editor/editor",
    "build:all": "turbo run build",
    "test": "turbo run test --filter=@3d-editor/editor",
    "lint": "turbo run lint --filter=@3d-editor/editor",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,vue,md,json}\"",
    "clean": "turbo run clean",
    "version:patch": "pnpm --filter @3d-editor/editor exec npm version patch",
    "version:minor": "pnpm --filter @3d-editor/editor exec npm version minor",
    "version:major": "pnpm --filter @3d-editor/editor exec npm version major",
    "publish": "pnpm build && pnpm --filter @3d-editor/editor publish --access public"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "turbo": "^1.12.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
